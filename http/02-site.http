### ─────────────────────────────────────────────────────────────────────────
###  GoPCMS — 사이트 · 템플릿 · 테마 · 레이아웃 (3축 모델)
###
###  전제: 01-auth.http 의 1~3 을 먼저 실행해 관리자 세션과 {{csrfAdmin}} 확보.
###  필요 권한: 전 요청 ROLE_ADMIN (tb_role_url_access /adm/** pri 20)
###
###  3축 = layout(구조·뷰 폴더) · template(시각 언어·CSS 1장) · theme(색·html 클래스).
###  사이트가 세 축을 선택한다(tb_site.template_id/layout_id/theme).
###
###  사이트 식별은 <b>헤더가 아니다</b> — X-Site-Code 같은 헤더는 이 프로젝트에 없다.
###  해석 순서(SiteResolveFilter): ① 경로의 siteCode 자리 → ② ?siteCode= → ③ 기본 사이트
###    · 컨텐츠 : /{siteCode}/{slug}        (첫 번째 세그먼트)
###    · 프로그램: /bbs/{siteCode}/{bbsCode} (두 번째 세그먼트)
###    · /adm/** : SKIP — 사이트 개념이 없다
###
###  ── 실행 순서 ─────────────────────────────────────────────────────────
###   화면 조회는 순서 무관. 저장(POST)은 목록/폼 GET 으로 최신 CSRF 를 잡은 뒤 실행.
### ─────────────────────────────────────────────────────────────────────────

### ─── 사이트 해석 계약 (무인증 · front) ────────────────────────────────────

### 루트 → 기본 사이트 랜딩 — GET /
GET {{baseUrl}}/
Accept: text/html

> {%
    client.test("기본 사이트로 302", function () {
        client.assert(response.status === 302,
            "예상 status=302, 실제=" + response.status);
    });
%}

### 사이트 랜딩 — GET /{siteCode}/index
GET {{baseUrl}}/{{siteCode}}/index
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
    client.test("HTML 응답", function () {
        const ct = response.headers.valueOf("Content-Type") || "";
        client.assert(ct.includes("text/html"), "HTML 이 아니다: " + ct);
    });
%}

### 사이트맵 — GET /{siteCode}/sitemap
GET {{baseUrl}}/{{siteCode}}/sitemap
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
%}

### 다른 사이트 랜딩 — GET /{siteCodeAlt}/index  (레이아웃 축이 다른 사이트)
GET {{baseUrl}}/{{siteCodeAlt}}/index
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
%}

### 미등록 사이트코드 — GET /nosite/index  (404 계약: 기본 사이트로 위장하지 않는다)
GET {{baseUrl}}/nosite/index
Accept: text/html

> {%
    client.test("404", function () {
        client.assert(response.status === 404,
            "예상 status=404, 실제=" + response.status
            + " — 200 이면 canonical 원칙(위장 응답 금지)이 깨졌다");
    });
%}

### 템플릿 CSS 스트리밍 — GET /tmpl/css/{templateCode}.css
### 인가: /tmpl/** PERMIT_ALL(pri 44)
GET {{baseUrl}}/tmpl/css/krds.css
Accept: text/css

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
    client.test("CSS Content-Type", function () {
        const ct = response.headers.valueOf("Content-Type") || "";
        client.assert(ct.includes("css"), "CSS 가 아니다: " + ct);
    });
%}

### ─── 사이트 관리 (/adm/site) ──────────────────────────────────────────────

### 사이트 목록 — GET /adm/site
GET {{baseUrl}}/adm/site
Accept: text/html

> {%
    client.test("관리자 화면 200", function () {
        client.assert(response.status === 200,
            "예상 status=200, 실제=" + response.status + " — 302 면 관리자 세션 없음");
    });
    const m = String(response.body).match(/name="_csrf"\s+value="([^"]+)"/);
    if (m) { client.global.set("csrfAdmin", m[1]); }
%}

### 사이트 등록 폼 — GET /adm/site/form
GET {{baseUrl}}/adm/site/form
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
%}

### 사이트 수정 폼 — GET /adm/site/form?siteId={siteId}
GET {{baseUrl}}/adm/site/form?siteId={{sampleSiteId}}
Accept: text/html

> {%
    client.test("200 또는 목록 리다이렉트", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    const m = String(response.body).match(/name="_csrf"\s+value="([^"]+)"/);
    if (m) { client.global.set("csrfAdmin", m[1]); }
%}

### 사이트 저장 — POST /adm/site/save
### @ModelAttribute("siteForm") SiteAdmDto — 폼 전송(JSON 아님)
### 필드: siteCode·siteName·domain·defaultLang·parentSiteId·templateId·themeId·
###       layoutId·defaultYn·sortOrder·logoPath·faviconPath·description·headMeta·
###       copyright·useYn
### ⚠ siteId 를 비우면 신규 등록이다. 아래는 <b>신규 테스트 사이트</b>를 만든다.
POST {{baseUrl}}/adm/site/save
Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrfAdmin}}

siteCode=httptest&siteName=HTTP%20Client%20%ED%85%8C%EC%8A%A4%ED%8A%B8&defaultLang=ko&sortOrder=99&useYn=Y&defaultYn=N

> {%
    client.test("저장 처리", function () {
        // 성공 302(목록) / 검증 실패 200(폼 재표시) 둘 다 정상 응답이다
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    if (response.status === 200) {
        client.log("폼이 다시 그려졌다 — 검증 오류 메시지를 응답에서 확인할 것");
    }
%}

### 사이트 삭제 — POST /adm/site/delete
# 주의: 실제 데이터가 삭제될 수 있으므로 로컬 또는 테스트 환경에서만 실행
# TODO 확인 필요 — 위 저장으로 만든 httptest 사이트의 siteId 를 조회해 넣어야 한다.
#                  응답이 HTML 리다이렉트라 ID 를 스크립트로 뽑을 수 없다.
POST {{baseUrl}}/adm/site/delete
Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrfAdmin}}

siteId={{missingId}}

> {%
    client.test("삭제 요청 처리", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

