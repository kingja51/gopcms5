### 15. 관리자 직접 다운로드 — GET /adm/file/{fileId}/download
### 상태 무관 다운로드(download_type=ADMIN). 이력에 ADMIN 으로 남는다.
GET {{baseUrl}}/adm/file/{{sampleFileId}}/download

> {%
    client.test("응답 상태", function () {
        client.assert([200, 302, 404].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    if (response.status === 200) {
        const cd = response.headers.valueOf("Content-Disposition") || "";
        client.test("첨부 응답", function () {
            client.assert(cd.includes("attachment") || cd.length > 0,
                "Content-Disposition 이 없다");
        });
        client.log("Content-Disposition: " + cd);
    }
%}

