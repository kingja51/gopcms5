Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrfAdmin}}

entityType=NO_SUCH_TYPE&entityId={{sampleSiteId}}&attachments={{sampleFileId}}

> {%
    client.test("검증이 작동한다", function () {
        client.assert([200, 302, 400].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

### 19. 파일 삭제(soft) — POST /adm/file/{fileId}/delete
# 주의: 실제 데이터가 삭제될 수 있으므로 로컬 또는 테스트 환경에서만 실행
### soft delete 다 — 물리 삭제는 정리 배치(retention-days=180, dry-run 기본 true)가 한다.
POST {{baseUrl}}/adm/file/{{sampleFileId}}/delete
Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrfAdmin}}

> {%
    client.test("삭제 처리", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

### 20. 파일 복구 — POST /adm/file/{fileId}/restore
### soft delete 된 파일을 되살린다(물리 파일이 남아 있는 동안만 가능).
POST {{baseUrl}}/adm/file/{{sampleFileId}}/restore
Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrfAdmin}}

> {%
    client.test("복구 처리", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}
