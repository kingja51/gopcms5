### ─── 관리자 파일 관리 (/adm/file) ─────────────────────────────────────────
### ### 전제: 관리자 계정 로그인 및 CSRF 토큰 확보가 필요함
### 필요 권한: ROLE_ADMIN

### 9. 파일 목록 — GET /adm/file
### 검색 조건(FileSearch): entityType · extension · scanStatus · includeDeleted · page · size
GET {{baseUrl}}/adm/file
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    const body = String(response.body);
    const f = body.match(/FIL_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/);
    if (f) {
        client.global.set("sampleFileId", f[0]);
        client.log("sampleFileId = " + f[0]);
    }
    const c = body.match(/name="_csrf"\s+value="([^"]+)"/);
    if (c) { client.global.set("csrfAdmin", c[1]); }
%}

### 10. 파일 목록 — 삭제분 포함
GET {{baseUrl}}/adm/file?includeDeleted=true&entityType=ETC
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

