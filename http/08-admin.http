        client.assert([200, 302, 400].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

### ─── 감사 로그 (/adm/audit-log) ────────────────────────────────────────────
### 관리자 CUD 전수. 이 파일의 POST 요청들이 실행되면 여기에 행이 쌓인다 —
### 위 요청들을 먼저 돌린 뒤 조회하면 결과를 눈으로 대조할 수 있다.
### 읽기 전용이며, GET 조회 자체는 감사 로그에 남지 않는다.

### 감사 로그 목록 — GET /adm/audit-log
### 검색: keyword(action·target_entity·target_id·request_uri 부분일치) ·
###       action · targetEntity · result 정확일치 · page · size
GET {{baseUrl}}/adm/audit-log
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
    client.test("감사 기록이 쌓이고 있다", function () {
        const empty = String(response.body).includes("기록된 변경이 없습니다");
        client.assert(!empty,
            "⚠ 감사 로그가 비어 있다 — 이 파일의 POST 요청을 먼저 실행했는지 확인할 것");
    });
%}

### 감사 로그 — 거부된 요청만 (FAIL)
### 값 검증 실패, 정책상 거부(글 있는 게시판 삭제 등)가 여기 모인다.
GET {{baseUrl}}/adm/audit-log?result=FAIL
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
%}

### 감사 로그 — 대상·행위 필터
### target_entity 예: BOARD · BOARD_ARTICLE · BOARD_CATEGORY · MEMBER · SITE ·
###                   CONTENT · MENU · ROLE · URL_ACCESS · FILE · THEME · TEMPLATE ·
###                   LAYOUT · PASSWORD · 2FA
### action 예: CREATE · UPDATE · DELETE · SAVE · STATUS · UNLOCK · WITHDRAW ·
###            EVICT · REBUILD · MODERATE · REVIEW · RESTORE · BATCH_NOTICE …
GET {{baseUrl}}/adm/audit-log?targetEntity=MEMBER&action=STATUS
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
%}

### 감사 로그 상세 — GET /adm/audit-log/{logAuditId}
### 경로 제약 {logAuditId:\d+} — log_audit 은 UUID 가 아니라 bigint AUTO_INCREMENT 다.
### 없는 ID 는 404 가 아니라 목록으로 302(보존기간 배치가 지운 뒤의 북마크 접근).
### before_json·after_json 은 현재 항상 NULL 이다 — 값 스냅샷은 도입하지 않았다.
GET {{baseUrl}}/adm/audit-log/1
Accept: text/html

> {%
    client.test("상세 또는 목록 리다이렉트", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

