### 회원 목록 CSV 내려받기 — GET /adm/member/export
### 필요 권한: ROLE_PRIVACY (tb_role_url_access pri 15) — ROLE_ADMIN 상속 없음
### 시드 admin 은 ROLE_PRIVACY 가 없어 <b>403 또는 로그인 유도가 정상</b>이다.
GET {{baseUrl}}/adm/member/export
Accept: text/csv

> {%
    client.test("권한 정책 확인", function () {
        client.assert([200, 302, 403].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    if (response.status === 200) {
        client.test("CSV 응답", function () {
            const cd = response.headers.valueOf("Content-Disposition") || "";
            const ct = response.headers.valueOf("Content-Type") || "";
            client.assert(cd.includes("attachment") || ct.includes("csv"),
                "첨부 응답이 아니다: Content-Type=" + ct + " Content-Disposition=" + cd);
        });
    } else {
        client.log("403/302 — ROLE_PRIVACY 미보유(설계된 동작). 내려받기 시도도 이력에 남는다");
    }
%}

### ─── 회원 생명주기 배치 수동 실행 ──────────────────────────────────────────
### POST /adm/member/batch/{job} — job: notice | dormant | withdraw | purge
### ⚠ dry-run 설정(gopcms.member.lifecycle.dry-run, 기본 true)이 <b>그대로 적용</b>된다.
###   손으로 돌릴 때만 진짜로 지워지는 동작은 사고를 부르기 때문이다.
###   결과는 응답이 아니라 <b>서버 로그</b>에 남는다.

