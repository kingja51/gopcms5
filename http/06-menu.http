### ─────────────────────────────────────────────────────────────────────────
###  GoPCMS — 메뉴 관리
###
###  ### 전제: 관리자 계정 로그인 및 CSRF 토큰 확보가 필요함
###           → 01-auth.http 의 1~3 을 먼저 실행한다.
###  필요 권한: 전 요청 ROLE_ADMIN (tb_role_url_access /adm/** pri 20)
###
###  메뉴는 사용자 화면 전용 엔드포인트가 없다 — GNB·사이트맵이 사이트 컨텍스트에서
###  직접 읽는다(/{siteCode}/sitemap 으로 결과를 확인한다).
###
###  ── 실행 순서 ─────────────────────────────────────────────────────────
###   1. 목록 GET (CSRF 확보) → 2. 등록 폼 GET → 3. 저장 POST
###   → 4. 사이트맵으로 반영 확인 → 5. 삭제(파괴적)
### ─────────────────────────────────────────────────────────────────────────

### 1. 메뉴 목록 — GET /adm/menu?siteId={siteId}
GET {{baseUrl}}/adm/menu?siteId={{sampleSiteId}}
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200,
            "예상 status=200, 실제=" + response.status + " — 302 면 관리자 세션 없음");
    });
    const m = String(response.body).match(/name="_csrf"\s+value="([^"]+)"/);
    client.test("CSRF 토큰 확보", function () {
        client.assert(m !== null, "_csrf 를 찾지 못했다");
    });
    if (m) { client.global.set("csrfAdmin", m[1]); }
%}

### 2. 메뉴 등록 폼 — GET /adm/menu/form?siteId={siteId}
GET {{baseUrl}}/adm/menu/form?siteId={{sampleSiteId}}
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    const m = String(response.body).match(/name="_csrf"\s+value="([^"]+)"/);
    if (m) { client.global.set("csrfAdmin", m[1]); }
%}

### 3. 메뉴 수정 폼 — GET /adm/menu/form?menuId={menuId}
GET {{baseUrl}}/adm/menu/form?menuId={{sampleMenuId}}&siteId={{sampleSiteId}}
Accept: text/html

> {%
    client.test("폼 응답", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    const m = String(response.body).match(/name="_csrf"\s+value="([^"]+)"/);
    if (m) { client.global.set("csrfAdmin", m[1]); }
%}

### 4. 메뉴 저장 — POST /adm/menu/save
### @ModelAttribute("menu") MenuAdmDto (폼 전송)
### 필드: menuId·siteId·parentMenuId·menuName·menuType·linkTargetId·linkUrl·
###       sortOrder·depth·authRequiredYn·useYn
### menuType 값은 tb_menu 의 CHECK 제약을 따른다 — 화면 select 의 옵션이 유일한 근거다.
###   확인된 값: CONTENT(컨텐츠 연결 — linkTargetId=contentId)
### # TODO 확인 필요 — CONTENT 외 menuType 허용값 전체(FOLDER·LINK·BBS 등)는
###                    tb_menu DDL 의 chk 제약을 열어 확인할 것
POST {{baseUrl}}/adm/menu/save
Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrfAdmin}}

siteId={{sampleSiteId}}&menuName=HTTP%20%ED%85%8C%EC%8A%A4%ED%8A%B8%20%EB%A9%94%EB%89%B4&menuType=CONTENT&linkTargetId={{sampleContentId}}&sortOrder=99&depth=1&authRequiredYn=N&useYn=Y

> {%
    client.test("저장 처리", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    if (response.status === 200) {
        client.log("폼 재표시 — 검증 메시지를 응답에서 확인할 것");
    }
%}

### 5. 메뉴 반영 확인 — GET /{siteCode}/sitemap  (무인증)
GET {{baseUrl}}/{{siteCode}}/sitemap
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
    client.test("등록한 메뉴가 보인다", function () {
        const body = String(response.body);
        // 메뉴가 use_yn='Y' 이고 사이트 캐시가 갱신되면 사이트맵에 나타난다
        client.assert(body.length > 0, "본문이 비어 있다");
    });
%}

### 6. 메뉴 삭제 — POST /adm/menu/delete
# 주의: 실제 데이터가 삭제될 수 있으므로 로컬 또는 테스트 환경에서만 실행
# TODO 확인 필요 — 위에서 만든 메뉴의 menuId 를 넣어야 실제로 지워진다.
#                  HTML 리다이렉트 응답이라 ID 를 스크립트로 뽑을 수 없다.
POST {{baseUrl}}/adm/menu/delete
Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrfAdmin}}

menuId={{missingId}}&siteId={{sampleSiteId}}

> {%
    client.test("삭제 요청 처리", function () {
        client.assert([200, 302].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}
