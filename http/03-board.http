### ─── 반응 API (JSON) ──────────────────────────────────────────────────────
### 공통 응답 래퍼가 <b>없다</b> — 컨트롤러가 만든 플랫 Map 을 그대로 돌려준다.
### 좋아요 응답: {"liked": true, "count": 1}
### 신고 응답  : {"accepted": true, "message": "..."}

### 10. 좋아요 토글 — POST /api/v1/board/like
### 인가: AUTHENTICATED (pri 72). 익명 불가.
### @RequestParam targetType · targetId · sourceUrl(선택)
### targetType 허용값(ReactionTarget): ARTICLE | COMMENT | CONTENT
POST {{baseUrl}}/api/v1/board/like
Content-Type: application/x-www-form-urlencoded
X-CSRF-TOKEN: {{csrf}}
Accept: application/json

targetType=ARTICLE&targetId={{sampleArticleId}}&sourceUrl=%2Fbbs%2F{{siteCode}}%2F{{sampleBbsCode}}

> {%
    client.test("응답 상태", function () {
        client.assert([200, 302, 400, 401, 403].includes(response.status),
            "예상 밖 status=" + response.status);
    });
    if (response.status === 200) {
        client.test("JSON 응답", function () {
            const ct = response.headers.valueOf("Content-Type") || "";
            client.assert(ct.includes("application/json"), "JSON 이 아니다: " + ct);
        });
        client.test("liked·count 필드", function () {
            client.assert(response.body.liked !== undefined, "liked 가 없다");
            client.assert(response.body.count !== undefined, "count 가 없다");
        });
        client.log("liked=" + response.body.liked + " count=" + response.body.count);
    }
%}

