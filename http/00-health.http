### ─────────────────────────────────────────────────────────────────────────
###  GoPCMS — 헬스 체크 · 액추에이터
###  전제: 없음(무인증). 서버가 떠 있는지, 노출 정책이 지켜지는지 확인한다.
###  인가 근거: tb_role_url_access — /actuator/health PERMIT_ALL(pri 52),
###            /actuator/** DENY(pri 90). health·info 외는 application.yml 에서도 미노출.
### ─────────────────────────────────────────────────────────────────────────

### 헬스 체크 — GET /actuator/health
GET {{baseUrl}}/actuator/health
Accept: application/json

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
    client.test("status=UP", function () {
        client.assert(response.body.status === "UP",
            "status 가 UP 이 아니다: " + JSON.stringify(response.body));
    });
%}

### 애플리케이션 정보 — GET /actuator/info
### exposure.include=health,info 이므로 노출되지만 본문은 비어 있을 수 있다.
GET {{baseUrl}}/actuator/info
Accept: application/json

> {%
    client.test("노출 정책 확인", function () {
        // DENY(pri 90)는 /actuator/** 이고 /actuator/info 는 그 하위 —
        // include 에 있어도 DB 규칙이 이기면 302/403 이 된다. 둘 다 정상으로 본다.
        client.assert([200, 302, 401, 403].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

### 차단되어야 하는 액추에이터 — GET /actuator/env
### 기대: DB 규칙 DENY(pri 90) → 미인증이므로 로그인 유도 302.
### (application.yml exposure 에도 없어 설사 인가를 통과해도 404 다)
GET {{baseUrl}}/actuator/env
Accept: application/json

> {%
    client.test("민감 엔드포인트가 열려 있지 않다", function () {
        client.assert(response.status !== 200,
            "⚠ /actuator/env 가 200 을 반환했다 — 노출 정책이 깨졌다");
        client.assert([302, 401, 403, 404].includes(response.status),
            "예상 밖 status=" + response.status);
    });
%}

### 차단되어야 하는 액추에이터 — GET /actuator/beans
GET {{baseUrl}}/actuator/beans
Accept: application/json

> {%
    client.test("민감 엔드포인트가 열려 있지 않다", function () {
        client.assert(response.status !== 200,
            "⚠ /actuator/beans 가 200 을 반환했다");
    });
%}

### 보안 응답 헤더 확인 — GET /{siteCode}/index
### SecurityHeadersFilter(@Order HIGHEST+5)가 전 응답에 부착한다.
GET {{baseUrl}}/{{siteCode}}/index
Accept: text/html

> {%
    client.test("200 응답", function () {
        client.assert(response.status === 200, "예상 status=200, 실제=" + response.status);
    });
    client.test("CSP 헤더 존재", function () {
        const csp = response.headers.valueOf("Content-Security-Policy")
                 || response.headers.valueOf("Content-Security-Policy-Report-Only");
        client.assert(csp !== null && csp !== undefined, "CSP 헤더가 없다");
    });
    client.test("script-src 에 nonce 가 있다", function () {
        const csp = response.headers.valueOf("Content-Security-Policy") || "";
        client.assert(csp.includes("'nonce-"), "nonce 가 없다: " + csp);
    });
    client.test("unsafe-eval 이 없다", function () {
        const csp = response.headers.valueOf("Content-Security-Policy") || "";
        client.assert(!csp.includes("'unsafe-eval'"),
            "⚠ unsafe-eval 이 허용돼 있다 (wasm-unsafe-eval 은 허용): " + csp);
    });
    client.test("X-Content-Type-Options=nosniff", function () {
        client.assert(response.headers.valueOf("X-Content-Type-Options") === "nosniff",
            "nosniff 가 없다");
    });
%}
