            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ================================================================
             11. NICE CheckPlus 안심본인인증
             ================================================================ -->
        <dependency>
            <groupId>nice</groupId>
            <artifactId>niceID</artifactId>
            <version>1.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/NiceID_v1.1.jar</systemPath>
        </dependency>

    </dependencies>


    <build>
        <finalName>gopcms5</finalName>
        <plugins>
            <!--
              Spring Boot plugin — 외부 Tomcat 배포 모드.
              · repackage 비활성화 — 표준 war 구조(WEB-INF/lib) 그대로 Tomcat 에 deploy.
                (Spring Boot 의 repackage 는 BOOT-INF/* 중첩 구조라 외부 Tomcat 의 표준
                 ClassLoader 와 비호환 — `Cannot load JDBC driver` 등 잠재 회귀 차단)
              · spring-boot:run (IntelliJ 임베디드 실행) 은 repackage 없이도 정상 동작.
              · 임베디드 실행 시 NICE 모듈 플래그 자동 부여.
              · system scope NICE jar 는 maven-war-plugin 의 <webResources> 가 WEB-INF/lib 로 복사.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                    <jvmArguments>${nice.jvm.args}</jvmArguments>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              war 패키징 + NICE jar 포함.
              system scope 의존성은 maven-war-plugin 이 기본으로 WEB-INF/lib 에 포함하지 않으므로
              <webResources> 로 직접 lib/*.jar 를 복사한다.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <archive>
                        <manifestEntries>
                            <!-- 운영 Tomcat 로그에서 빌드 추적용 -->
                            <Implementation-Title>${project.artifactId}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                    <webResources>
                        <resource>
                            <directory>${project.basedir}/lib</directory>
                            <targetPath>WEB-INF/lib</targetPath>
                            <includes>
                                <include>NiceID_*.jar</include>
                            </includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <!--
              Java 21 컴파일 + Lombok 애노테이션 프로세서.
              <release> 는 source/target 보다 안전 — JDK 21 만 인정.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              Surefire — Java 21 + NICE 모듈 플래그.
              테스트 클래스가 NiceID.Check.CPClient 를 인스턴스화하면 동일 플래그가 필요하므로
              argLine 에 명시. 다른 surefire 설정 (jacoco agent 등) 은 Spring Boot parent 가
              자동 주입하는 ${argLine} 변수를 보존하기 위해 끝에 concat.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} ${nice.jvm.args}</argLine>
                </configuration>
            </plugin>

            <!-- Spotless (코드 포맷터) -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.22.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
            </plugin>

            <!-- JaCoCo (커버리지) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              ============================================================
              Tailwind CSS 빌드 (시스템 Node — 별도 node 다운로드 없음)
              ============================================================
              · CDN(@tailwindcss/browser) 제거 후 런타임 JIT 이 사라져, 정적 output.css 를
                빌드 시점에 컴파일해야 한다(미빌드 시 화면 무스타일). 이를 Maven 에 묶어
                war 산출물이 항상 최신 CSS 를 포함하도록 강제.
              · generate-resources 바인딩 → 산출 output.css 가 곧이어 process-resources 에서
                target/classes 로 복사됨(=war 포함). 순서: install → run css.
              · npm 실행 파일은 OS 프로파일(npm-windows/npm-unix)에서 ${npm.executable} 주입.
              · 오프라인/자바 전용 컴파일은 -Dtailwind.skip=true 로 건너뜀.
              · 개발 중 빠른 반복은 `npm run css:watch` 를 별도 터미널에서 사용 권장.
              ============================================================
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${npm.executable}</executable>
                            <arguments>
                                <argument>install</argument>
                                <argument>--no-audit</argument>
                                <argument>--no-fund</argument>
                                <argument>--prefer-offline</argument>
                            </arguments>
                            <skip>${tailwind.skip}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build-css</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${npm.executable}</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>css</argument>
                            </arguments>
                            <skip>${tailwind.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <!-- Resources: mapper XML + 정적 리소스 (템플릿 로고·폰트 포함) -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.yml</include>
                    <include>**/*.yaml</include>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.sql</include>
                    <include>**/*.md</include>
                    <include>**/*.html</include>
                    <include>**/*.css</include>
                    <include>**/*.js</include>
                    <!-- 이미지 (템플릿 로고·디자인 자산) -->
                    <include>**/*.svg</include>
                    <include>**/*.png</include>
                    <include>**/*.jpg</include>
                    <include>**/*.jpeg</include>
                    <include>**/*.gif</include>
                    <include>**/*.webp</include>
                    <include>**/*.ico</include>
                    <!-- 폰트 -->
                    <include>**/*.woff</include>
                    <include>**/*.woff2</include>
                    <include>**/*.ttf</include>
                    <include>**/*.otf</include>
                    <include>**/*.eot</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
            </resource>
        </resources>
    </build>

    <!-- ================================================================
         Profiles — OS 별 npm 실행 파일 자동 선택 (exec-maven-plugin 용).
         Windows 는 npm.cmd, Unix/Mac 은 npm. 두 프로파일 모두 OS 로 자동 활성.
         ================================================================ -->
    <profiles>
        <profile>
            <id>npm-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <npm.executable>npm.cmd</npm.executable>
            </properties>
        </profile>
        <profile>
            <id>npm-unix</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
            </activation>
            <properties>
                <npm.executable>npm</npm.executable>
            </properties>
        </profile>
    </profiles>
</project>
