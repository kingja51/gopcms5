# ── Java / Maven ─────────────────────────────
target/
*.class
*.log
hs_err_pid*
replay_pid*

# ── Node / Tailwind 빌드 ─────────────────────
node_modules/
dist/
# Tailwind 빌드 산출물 (npm run css — Maven generate-resources 가 재생성)
src/main/resources/static/css/output.css

# ── IDE ──────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
out/

# ── OS ───────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── 로컬 설정 / 비밀 ─────────────────────────
*.local
.env
.env.*
# example 은 키 목록 문서 — 실비밀 금지 원칙 하에 커밋 허용
!.env.example
application-local.yml

# ── 기타 ─────────────────────────────────────
*.tmp
*.bak

# 업로드 저장소 — 로컬 개발용 기본 경로(application.yml gopcms.file.upload.*).
# 운영은 환경변수로 외부 마운트를 가리킨다. 업로드된 파일이 저장소에 들어가면 안 된다.
/data/
