# ── Java / Maven ─────────────────────────────
target/
*.class
*.log
hs_err_pid*
replay_pid*

# ── Node / Tailwind 빌드 ─────────────────────
node_modules/
dist/
# Tailwind 빌드 산출물 (npm run css — Maven generate-resources 가 재생성)
src/main/resources/static/css/output.css
# 위지윅 번들 (npm run editor — 같은 이유로 재생성. 소스는 src/editor/)
src/main/resources/static/js/vendor/editor-tiptap.js

# ── IDE ──────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
out/

# ── OS ───────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── 반입 라이브러리 (라이선스) ───────────────
# NICE 본인인증 jar 등 벤더 계약 산출물은 저장소에 두지 않는다 —
# 공개 저장소라 재배포가 곧 라이선스 위반이 된다. 빌드는 로컬 lib/ 의 파일을 쓴다
# (pom.xml 의 system scope · war include 설정은 그대로).
# 위지윅 상용 번들도 같은 이유로 커밋하지 않는다.
lib/*.jar
src/main/resources/static/js/vendor/crosseditor/
src/main/resources/static/js/vendor/ckeditor5/

# ── 로컬 설정 / 비밀 ─────────────────────────
*.local
.env
.env.*
# example 은 키 목록 문서 — 실비밀 금지 원칙 하에 커밋 허용
!.env.example
application-local.yml

# ── 기타 ─────────────────────────────────────
*.tmp
*.bak

# 업로드 저장소 — 로컬 개발용 기본 경로(application.yml gopcms.file.upload.*).
# 운영은 환경변수로 외부 마운트를 가리킨다. 업로드된 파일이 저장소에 들어가면 안 된다.
/data/

# 폰트 — 실제로 참조하는 것만 커밋한다(krds.css 의 @font-face 대상).
# 나머지는 로컬에 두되 저장소에 넣지 않는다: 미참조 바이너리 24MB 가 히스토리에 들어가면
# 되돌리기 어렵다(실제로 일괄 add 로 한 번 들어갔다가 되돌렸다).
src/main/resources/static/fonts/*
!src/main/resources/static/fonts/PretendardGOVVariable.woff2
!src/main/resources/static/fonts/PretendardVariable.woff2
