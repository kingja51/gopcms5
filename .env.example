# ============================================================================
#  gopcms5 — 환경변수 예시 (.env.example)
#  ----------------------------------------------------------------------------
#  실제 사용 파일은 .env (git ignore — 커밋 금지). 본 example 은 커밋되는
#  문서이므로 "키 목록 + 안내"만 제공하고 실제 비밀값을 절대 넣지 않는다.
#
#  application.yml 은 비밀값 기본 fallback 을 두지 않는다 — [필수] 키가
#  미주입이면 부팅 즉시 실패 (fail-fast, 의도된 동작. CLAUDE.md §보안).
# ============================================================================

# ── 필수 — 미주입 시 부팅 실패 ─────────────────────────────────────────────

# Jasypt ENC(...) 복호화용 마스터 비밀번호.
# 운영은 KMS / Vault 등 안전한 저장소에서 주입.
JASYPT_ENCRYPTOR_PASSWORD=change-me

# Gmail SMTP 발신 — 2단계 인증 후 발급한 "앱 비밀번호".
# https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER_PASSWD=change-me

# PII 암호화 (AES-256-GCM) 마스터 키 — base64 인코딩 32바이트 (conventions.md §6).
#   생성: openssl rand -base64 32   (아래는 문서용 더미 — 실환경 반드시 교체)
GOPCMS_PII_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# PII 검색 해시 (HMAC-SHA256) 키 — *_hash 컬럼(email_hash·di_hash 등) 산출용.
#   AES 마스터키와 반드시 분리(용도별 키 분리 원칙). 생성: openssl rand -base64 32
GOPCMS_PII_HMAC_KEY=YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODk=

# ── 권장 — 미주입 시 application.yml 의 비-비밀 기본값 사용 ─────────────

# 신뢰 프록시 CIDR CSV — 리버스 프록시(Nginx/L4) 뒤에 둘 때 그 대역을 넣는다.
#  비우면 X-Forwarded-For 를 무시하고 TCP 원격 주소만 쓴다(헤더는 위조 가능 —
#  프록시 없는 환경에서 신뢰하면 IP 화이트리스트·접근 로그가 통째로 속는다).
#  예: GOPCMS_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
GOPCMS_TRUSTED_PROXIES=

# 프로젝트 표기
GOPCMS_PROJECT_NAME_KO=(주)지오넷 GOPCMS 5.0
GOPCMS_PROJECT_NAME_EN=gopcms5

# DB 접속 3종 (3-DB 분리 — conventions.md §3. 기본: MariaDB 11.8)
#  PostgreSQL 전환 시 URL/DRIVER 만 교체 (org.postgresql.Driver — war 동봉)
GOPCMS_DB_PRIMARY_URL=jdbc:mariadb://localhost:3306/gopcms_primary?characterEncoding=UTF-8
GOPCMS_DB_PRIMARY_USER=gopcms
GOPCMS_DB_PRIMARY_PASSWORD=change-me
GOPCMS_DB_PRIMARY_DRIVER=org.mariadb.jdbc.Driver
GOPCMS_DB_SECONDARY_URL=jdbc:mariadb://localhost:3306/gopcms_secondary?characterEncoding=UTF-8
GOPCMS_DB_SECONDARY_USER=gopcms
GOPCMS_DB_SECONDARY_PASSWORD=change-me
GOPCMS_DB_SECONDARY_DRIVER=org.mariadb.jdbc.Driver
GOPCMS_DB_LOGGING_URL=jdbc:mariadb://localhost:3306/gopcms_logging?characterEncoding=UTF-8
GOPCMS_DB_LOGGING_USER=gopcms
GOPCMS_DB_LOGGING_PASSWORD=change-me
GOPCMS_DB_LOGGING_DRIVER=org.mariadb.jdbc.Driver

# 파일 저장소 (기본 /data/gopcms5/*)
GOPCMS_UPLOAD_ROOT=/data/gopcms5/uploads
GOPCMS_QUARANTINE=/data/gopcms5/quarantine
GOPCMS_THUMBNAIL=/data/gopcms5/thumbnail
GOPCMS_PREVIEW_CACHE=/data/gopcms5/preview-cache

# 외부 라이브러리 설치 위치 (JODConverter — 미설치 시 PPTX 미리보기 폴백)
GOPCMS_LIBREOFFICE_HOME=C:/Program Files/LibreOffice

# ── 외부 API (사용 기능 활성 시에만 필요) ──────────────────────────────────

# SNS 로그인 (OAuth2) — 콜백 도메인은 개발 터널(ngrok 등)/운영 도메인으로 교체
GOPCMS_OAUTH2_REDIRECT_BASE_URL=https://example.ngrok-free.app
GOPCMS_OAUTH2_NAVER_CLIENT_ID=
GOPCMS_OAUTH2_NAVER_CLIENT_SECRET=
GOPCMS_OAUTH2_NAVER_CALLBACK_URL=https://example.ngrok-free.app/member/oauth2/naver/callback
GOPCMS_OAUTH2_KAKAO_CLIENT_ID=
GOPCMS_OAUTH2_KAKAO_CLIENT_SECRET=
GOPCMS_OAUTH2_KAKAO_CALLBACK_URL=https://example.ngrok-free.app/member/oauth2/kakao/callback
GOPCMS_OAUTH2_GOOGLE_CLIENT_ID=
GOPCMS_OAUTH2_GOOGLE_CLIENT_SECRET=
GOPCMS_OAUTH2_GOOGLE_CALLBACK_URL=https://example.ngrok-free.app/member/oauth2/google/callback

# NICE CheckPlus 본인인증 (계약 사이트코드/비밀번호)
GOPCMS_NICE_SITE_CODE=
GOPCMS_NICE_SITE_PASSWORD=
GOPCMS_NICE_RETURN_URL=https://example.ngrok-free.app/member/identity/nice/success
GOPCMS_NICE_ERROR_URL=https://example.ngrok-free.app/member/identity/nice/fail

# 지도 (오시는길 등)
GOPCMS_KAKAO_MAP_APPKEY=
GOPCMS_NAVER_MAP_CLIENT_ID=
GOPCMS_GOOGLE_MAP_API_KEY=

# CAPTCHA (reCAPTCHA)
GOPCMS_CAPTCHA_ENABLED=false
GOPCMS_CAPTCHA_SITE_KEY=
GOPCMS_CAPTCHA_SECRET_KEY=

# 공공 OpenAPI (data.go.kr 발급, URL-encoded)
#   KMA = 기상청 날씨 위젯(마스트헤드), G2B = 조달청 나라장터(클라이언트 프로그램용)
GOPCMS_KMA_SERVICE_KEY=
GOPCMS_G2B_SERVICE_KEY=

# 리버스 프록시 뒤 배포 시 신뢰 프록시 대역 (X-Forwarded-* 수용 범위)
GOPCMS_TRUSTED_PROXIES=

# Google Gemini AI (검색 보조) — 미설정 시 부팅 성공, 보조검색만 비활성(빈 등록 skip 폴백)
#   발급: https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
